# ─── web_search.py（统一 Web 搜索/抓取后端）───
# 对外调用本服务时的 x-api-key；留空表示不启用鉴权（行为对齐 region_jobs / tianyancha）
# WEB_SEARCH_API_KEY=your-internal-api-key
# 两家 provider 的密钥；生产必须填，禁止提交真实 key
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx
# SEARCHAPI_IO_API_KEY=your-searchapi-key
# auto 模式下的回退链；按顺序尝试，前者无结果/失败才走下一个
# WEB_SEARCH_DEFAULT_PROVIDERS=["tavily","searchapi_google"]
# 默认/上限（top_k 取两家 provider 的下界）
# WEB_SEARCH_DEFAULT_TOP_K=5
# WEB_SEARCH_MAX_TOP_K=10
# 单 provider 调用超时（秒）
# WEB_SEARCH_PROVIDER_TIMEOUT_SEC=30.0
# 正文抓取的并发与超时（仅 search-and-fetch / fetch 端点）
# WEB_SEARCH_DEFAULT_CONCURRENCY=5
# WEB_SEARCH_MAX_CONCURRENCY=10
# WEB_SEARCH_FETCH_HTML_TIMEOUT_SEC=15.0
# WEB_SEARCH_DOC_DOWNLOAD_TIMEOUT_SEC=60.0
# 单条正文最大字符数（默认/上限）
# WEB_SEARCH_DEFAULT_CONTENT_CHARS=8000
# WEB_SEARCH_MAX_CONTENT_CHARS=50000
# Provider HTTP 基地址（一般不动；联调/灰度可指向 mock）
# WEB_SEARCH_TAVILY_BASE_URL=https://api.tavily.com
# WEB_SEARCH_SEARCHAPI_BASE_URL=https://www.searchapi.io/api/v1/search
# Redis 缓存开关与 TTL
# WEB_SEARCH_CACHE_ENABLED=true
# WEB_SEARCH_CACHE_TTL_SEARCH_SEC=300
# WEB_SEARCH_CACHE_TTL_FETCH_SEC=1800

# ─── boss_zhipin.py + services/boss_zhipin_client.py ───
# BOSS_ZHIPIN_API_KEY=your-secret-key-here
# BOSS_ZHIPIN_BROWSER_HOST_PORT=127.0.0.1:9527
# 多账号 / 多 Chrome profile worker 池。为空时沿用单 worker。
# 注意：每个 worker 应绑定独立账号、独立 Chrome profile、独立调试端口、稳定代理出口；
# 不建议请求级随机切换代理。代理池配置的是“本地可消费 HTTP/SOCKS 端口”，不是 VLESS/CF
# 优选入口 IP；VLESS/Clash 节点应先由 Clash/mihomo 或认证转发器固定暴露为本地端口。
# Chrome 启动时必须绑定同一稳定代理出口，避免浏览器铸 cookie 和 httpx 直连接口使用不同出口。
# Clash 7890 AUTO 只能证明可访问，不能提供多 worker 出口隔离；生产放量请为每个 worker 固定节点。
# BOSS_ZHIPIN_PROXY_POOL=[{"proxy_id":"boss-proxy-a","local_proxy_url":"http://127.0.0.1:18081","chrome_proxy_server":"http=127.0.0.1:18081;https=127.0.0.1:18081","upstream_label":"CF官方优选1"},{"proxy_id":"boss-proxy-b","local_proxy_url":"http://127.0.0.1:18082","chrome_proxy_server":"http=127.0.0.1:18082;https=127.0.0.1:18082","upstream_label":"CF官方优选2"}]
# BOSS_ZHIPIN_PROXY_HEALTHCHECK_URL=https://httpbin.org/ip
# BOSS_ZHIPIN_PROXY_HEALTHCHECK_TIMEOUT_SEC=8
# BOSS_ZHIPIN_PROXY_COOLDOWN_MINUTES=120
# 代理选择策略：ordered=按文件顺序；random=从健康可用代理中随机；round_robin=轮转。
# BOSS_ZHIPIN_PROXY_SELECTION_STRATEGY=ordered
# BOSS_ZHIPIN_PROXY_RECENT_AVOID_COUNT=0
# 主 API 多 worker 模式下，BOSS 采集建议拆到单进程 boss_server；
# 主 API 的 BOSS 路由会代理到该内部地址，避免 4 个 worker 争抢同一批 Chrome profile。
# BOSS_SERVICE_URL=http://127.0.0.1:2926
# BOSS_SERVICE_API_KEY=
# BOSS_PROXY_TIMEOUT_SEC=95
# 访问受限后是否允许单 worker 自动换代理并重启 Chrome。需要本机部署可管理 Chrome 进程时再开启。
# BOSS_ZHIPIN_RECOVER_WORKERS_ON_ACCESS_LIMIT=false
# 开启后 boss_server 启动会以 boss-workers.json 为真相自动 reconcile：清理临时浏览器+孤儿
# 状态文件、按配置 ensure Chrome worker、打开 httpbin 校验出口（结果见 /health worker_report
# 与 logs/boss/reconciler.log）。增减 worker 后只需重启 boss_server，无需手动 kill/跑 ps1/查端口。
# BOSS_ZHIPIN_MANAGE_CHROME_WORKERS=false
# BOSS_ZHIPIN_CHROME_RECOVERY_COOLDOWN_MINUTES=5
# BOSS_ZHIPIN_LOGIN_REQUIRED_COOLDOWN_MINUTES=0
# BOSS_ZHIPIN_CHROME_PATH=
# BOSS_ZHIPIN_CHROME_PROFILE_ROOT=runtime/chrome-profiles
# BOSS_ZHIPIN_WORKER_STATE_ROOT=runtime/boss-workers
# BOSS_ZHIPIN_WORKER_DEVTOOLS_TIMEOUT_SEC=10
# 100+ 代理长期维护建议放 JSON 文件，file 优先于上面的内联 JSON。
# BOSS_ZHIPIN_PROXY_POOL_FILE=secrets/boss-proxy-pool.json
# BOSS_ZHIPIN_WORKERS_FILE=secrets/boss-workers.json
# profile_id 必须稳定保留以复用登录态；复用已登录浏览器时建议保留初始 proxy_id，
# 确保浏览器铸 token 的出口与 httpx 请求出口一致。随机策略主要用于异常恢复换代理。
# BOSS_ZHIPIN_WORKERS=[{"worker_id":"boss-a","browser_host_port":"127.0.0.1:9527","profile_id":"account-a","proxy_id":"boss-proxy-a","per_worker_concurrency":1},{"worker_id":"boss-b","browser_host_port":"127.0.0.1:9528","profile_id":"account-b","proxy_id":"boss-proxy-b","per_worker_concurrency":1}]
# BOSS_ZHIPIN_MAX_COMBINATIONS=10
# BOSS_ZHIPIN_MAX_PAGES=3
# BOSS_ZHIPIN_MAX_ITEMS_PER_QUERY=100
# BOSS_ZHIPIN_LISTEN_TIMEOUT_SEC=15.0
# BOSS_ZHIPIN_SYNC_TIMEOUT_SEC=90.0
# BOSS_ZHIPIN_MIN_DELAY_SEC=1.0
# BOSS_ZHIPIN_MAX_DELAY_SEC=2.5
# BOSS_ZHIPIN_DETAIL_MIN_DELAY_SEC=1.0
# BOSS_ZHIPIN_DETAIL_MAX_DELAY_SEC=2.0

