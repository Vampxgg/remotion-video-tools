# ─── cre_image.py（Gemini 文/图生图）───
# 说明：本模块访问 Vertex/GCS(googleapis.com)，httpx 一律 trust_env=False 强制直连，
#       无代理开关；如需翻墙访问 Google，应在网络层解决，而非在此配代理。
# CRE_IMAGE_OUTPUT_DIR=gemini_images
# CRE_IMAGE_MAX_REFERENCE_BYTES=7340032
# CRE_IMAGE_HTTPX_READ_TIMEOUT=360.0
# CRE_IMAGE_HTTPX_CONNECT_TIMEOUT=15.0
# CRE_IMAGE_HTTPX_WRITE_TIMEOUT=60.0
# CRE_IMAGE_HTTPX_POOL_TIMEOUT=30.0
# 留空表示不做白名单限制；逗号分隔多个主机
# CRE_IMAGE_ALLOWED_URL_HOSTS=

# ─── cre_image_azure.py（Azure OpenAI gpt-image-2 文/图生图）───
# 与 cre_image.py（Vertex Gemini）物理隔离；GCS 存储桶/公网前缀复用上面的 GCS_* 配置。
# 资源 endpoint（末尾斜杠可有可无）
# CRE_IMAGE_AZURE_ENDPOINT=https://x-pilot-6-resource.cognitiveservices.azure.com
# 资源密钥（生产必须填，禁止提交真实 key）；留空则接口拒绝处理
# CRE_IMAGE_AZURE_API_KEY=your-azure-openai-key
# 部署名（Azure 以部署名寻址，不是模型名）
# CRE_IMAGE_AZURE_DEPLOYMENT=gpt-image-2
# REST 接口版本（不是模型版本）；gpt-image-2 实测可用 2025-04-01-preview
# CRE_IMAGE_AZURE_API_VERSION=2025-04-01-preview
# 多区域 endpoint 池；配置后优先使用，未配置则回退到上面的单 endpoint。
# 单项字段：name/endpoint/api_key/deployment/weight/max_concurrency。
# CRE_IMAGE_AZURE_ENDPOINTS_JSON=[{"name":"westus3","endpoint":"https://<resource>.cognitiveservices.azure.com","api_key":"your-key","deployment":"gpt-image-2","weight":1,"max_concurrency":5}]
# CRE_IMAGE_AZURE_DEFAULT_QUALITY=medium
# CRE_IMAGE_AZURE_DEFAULT_OUTPUT_FORMAT=png
# CRE_IMAGE_AZURE_OUTPUT_DIR=azure_images
# CRE_IMAGE_AZURE_MAX_REFERENCE_BYTES=52428800
# CRE_IMAGE_AZURE_HTTPX_READ_TIMEOUT=180.0
# CRE_IMAGE_AZURE_HTTPX_CONNECT_TIMEOUT=15.0
# CRE_IMAGE_AZURE_HTTPX_WRITE_TIMEOUT=60.0
# CRE_IMAGE_AZURE_HTTPX_POOL_TIMEOUT=30.0
# 参考图 URL 主机白名单；留空不限制，逗号分隔
# CRE_IMAGE_AZURE_ALLOWED_URL_HOSTS=
# 429 限流重试次数（指数退避）
# CRE_IMAGE_AZURE_MAX_RETRIES=2
# 多区域池默认单 endpoint 并发与短熔断参数
# CRE_IMAGE_AZURE_ENDPOINT_MAX_CONCURRENCY=5
# CRE_IMAGE_AZURE_CIRCUIT_FAILURE_THRESHOLD=3
# CRE_IMAGE_AZURE_CIRCUIT_COOLDOWN_SECONDS=60.0
# 出网代理拆分（方案 A）：本模块 httpx 一律不继承进程 HTTP(S)_PROXY，
# 由下面两项显式控制，避免本地代理误掐断长耗时请求。留空=直连。
# Azure API 出网代理（Azure 通常可直连，建议留空）
# CRE_IMAGE_AZURE_PROXY_URL=
# GCS 上传/gs_uri 下载出网代理（网络需翻墙访问 Google 时才填，如 http://127.0.0.1:7890）
# CRE_IMAGE_AZURE_GCS_PROXY_URL=

# ─── gemini_live.py（Gemini Live API 实时语音/视频）───
# 依赖：pip install google-genai websockets
# 首次真实联调前需执行：gcloud auth application-default login
# 并确认 GCP_PROJECT_ID / GCP_LOCATION_ID 指向已启用 Vertex AI API 的项目与区域。
# GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio
# GEMINI_LIVE_LANGUAGE_CODE=zh-CN
# 原生音频模型默认只支持 audio 响应；转写文本通过 transcription 事件返回。
# GEMINI_LIVE_RESPONSE_MODALITIES=["audio"]
# GEMINI_LIVE_ENABLE_TRANSCRIPTION=true
# GEMINI_LIVE_ENABLE_AFFECTIVE_DIALOG=true
# GEMINI_LIVE_PROACTIVE_AUDIO=false
# GEMINI_LIVE_CONTEXT_TRIGGER_TOKENS=10000
# GEMINI_LIVE_CONTEXT_TARGET_TOKENS=2048
# GEMINI_LIVE_MAX_AUDIO_BYTES_PER_MESSAGE=65536
# GEMINI_LIVE_MAX_VIDEO_BYTES_PER_MESSAGE=524288
# GEMINI_LIVE_SESSION_TIMEOUT_SEC=600
# GEMINI_LIVE_DEFAULT_SYSTEM_INSTRUCTION=你是一个实时语音助手。请使用简体中文自然、简洁地回答用户。
# GEMINI_LIVE_FRONTEND_DIR=frontend

# ─── cre_video.py（Vertex Veo 文/图生视频）───
# CRE_VIDEO_GCS_OUTPUT_URI=gs://x-pilot-storage/veo_video/
# CRE_VIDEO_POLLING_INTERVAL_SEC=10
