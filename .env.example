# =====================================================================
# 每日 Azure 模型消耗报告(api/usage_report_api.py)
# =====================================================================
# 鉴权走 azure.identity.DefaultAzureCredential：生产用服务主体(SP)。
# 先创建 SP 并授最小 RBAC(订阅域 Cost Management Contributor + 存储账户
# Storage Blob Data Contributor)：
#   az ad sp create-for-rbac --name xpilot-usage-report --skip-assignment
# 再把输出的 appId/tenant/password 填到下面三个标准变量(DefaultAzureCredential 自动识别)：
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_SECRET=
#
# 模块配置(均有默认值，按需取消注释覆盖；订阅/资源组/存储账户已在 settings 内置)：
# 端点 x-api-key 守卫；留空=不鉴权
# USAGE_REPORT_API_KEY=
# 每日自动生成时刻(北京)，晚于云函数 09:00 的 calls/requests 导出
# USAGE_REPORT_SCHEDULE_HHMM=09:10
# 是否开启每日自动调度
# USAGE_REPORT_ENABLE_SCHEDULER=True
# 生成后是否回传 blob(usage/ 前缀)
# USAGE_REPORT_UPLOAD_BLOB=True
# 当天已生成则跳过重算(补跑/多 worker 省时)
# USAGE_REPORT_SKIP_IF_CSV_EXISTS=False
