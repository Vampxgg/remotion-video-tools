# =====================================================================
# script_tools 项目环境变量样板
#
# 用法：
#   1. 复制本文件为 .env：    cp .env.example .env
#   2. 按需修改/填充各项；未填的字段会回落到 utils/settings.py 中的默认值
#   3. 所有"必须显式提供"的字段（密钥/账号/Cookie 等）默认无值，留空将运行
#      在受限模式（接口拒绝处理或不下发外部请求）
#
# 变量按"功能域"分组，与 utils/settings.py 中的 mixin 类一一对应。
# =====================================================================


# ─────────────── 应用层 / 基础设施 ───────────────
# Uvicorn 监听
APP_HOST=0.0.0.0
APP_PORT=2906
APP_WORKERS=4
# 用于在日志/响应里拼接对外可访问 URL 时的回退值
APP_PUBLIC_BASE_URL=http://127.0.0.1:2906

# CORS（生产环境务必收紧 CORS_ALLOW_ORIGINS）
CORS_ALLOW_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# 日志（True 表示禁用控制台输出，仅写文件，与历史默认一致）
LOG_DISABLE_CONSOLE=true
LOG_DIR=logs
LOG_BACKUP_COUNT=90

# 静态目录：相对路径会按"项目根 + STATIC_DIR"解析，避免 ./static 与 api/static 不一致
STATIC_DIR=static


# ─────────────── 数据库（PostgreSQL）───────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=
DB_NAME=script_tools_db
DB_ECHO=false


# ─────────────── Redis（Web 搜索/抓取缓存）───────────────
# docker-compose 默认起 redis:7-alpine，仅绑 127.0.0.1:6379
# 如果不部署 Redis，应用启动会 WARN 但不阻断，缓存自动降级为"不缓存"
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# 所有 key 的统一前缀，便于多环境共用一台 Redis 时区分
REDIS_KEY_PREFIX=script_tools


# ─────────────── RabbitMQ（暂保留，未实际启用）───────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/


# ─────────────── 公共出站 ───────────────
# 代理策略（重要，务必理解）：
#   - 代理只由 .env 显式配置才启用；不配 = 直连。代码绝不写全局 HTTP(S)_PROXY 环境变量，
#     代理只注入到对应模块自己的 HTTP client，不会外溢污染其它模块（尤其不影响 GCP 鉴权）。
#   - 优先级：各模块的 XXX_PROXY_URL 优先；未配则回退下面的 OUTBOUND_PROXY_URL；都未配 = 直连。
#   - 注意：不要在运行进程/系统里手动 export HTTP_PROXY / HTTPS_PROXY —— 本项目所有出网 client
#     均 trust_env=False，不会读取进程环境代理，手动 export 对本服务无效且易造成误解。
# 全局出站代理（任意 router 未单独配置 XXX_PROXY_URL 时的回退）
# OUTBOUND_PROXY_URL=http://127.0.0.1:7890
FETCH_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# fish.audio 全局密钥（生产必须填）
# FISH_API_KEY=fa_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Cloud / Vertex / GCS 共享配置
# 注意：cre_image(Vertex/GCS) 默认直连，不读进程环境代理。
#       但 /file/understand 的 Vertex(含 oauth2 token 刷新)出网代理由
#       FILE_UNDERSTAND_VERTEX_PROXY_URL / OUTBOUND_PROXY_URL 显式控制(见下方 file/understand 段)：
#       配了就走代理(国内机必需)，留空则直连。Azure 恒直连。
GCP_PROJECT_ID=x-pilot-469902
GCP_LOCATION_ID=us-central1
GCS_BUCKET_NAME=x-pilot-storage
GCS_PUBLIC_URL_PREFIX=https://storage.googleapis.com/x-pilot-storage
# Vertex/GCS 服务账号 JSON 路径(相对路径按项目根解析)；留空则回退 google.auth.default()。
# 配置后所有 Vertex 调用(理解/图/视频/live)统一使用该服务账号；切换账号时同步改 GCP_PROJECT_ID。
# GCP_CREDENTIALS_FILE=secrets/your-service-account.json


# =====================================================================
# /file/understand 多模态知识理解（高可用：主备 provider + 逐图补识别）
# 默认值与 utils/settings.py 一致；仅在需要覆盖时取消注释。
# =====================================================================
# 主用模型（Vertex Gemini）。
# FILE_UNDERSTAND_MODEL=gemini-2.5-flash
# 鉴权 API key；留空表示该接口不鉴权（生产建议配置）。
# FILE_UNDERSTAND_API_KEY=
# provider fallback 顺序：主用在前。vertex=Vertex Gemini(原生多模态)，azure=Azure VLM(PDF 拆页，异构故障域)。
# FILE_UNDERSTAND_PROVIDER_ORDER=vertex,azure
# Vertex 出网代理（同时作用于 generateContent 与 oauth2 token 刷新）。
# 国内服务器直连 googleapis.com 会超时，必须配代理；海外机/本地可直连则留空。
# 留空回落 OUTBOUND_PROXY_URL；Azure 恒直连(国内可达)，不受本项影响 → "Vertex 走代理 / Azure 直连"。
# FILE_UNDERSTAND_VERTEX_PROXY_URL=http://127.0.0.1:7890
# 单次 Vertex 调用超时与最多尝试区域数。
# FILE_UNDERSTAND_TIMEOUT_SEC=180
# FILE_UNDERSTAND_MAX_REGIONS=2
# 429/5xx/网络抖动换区前的退避（指数基数/上限，秒），配合满抖动缓解瞬时限流。
# FILE_UNDERSTAND_RETRY_BACKOFF_BASE_SEC=1.0
# FILE_UNDERSTAND_RETRY_BACKOFF_CAP_SEC=8.0
# 整个视觉阶段(排队+主备 provider+逐图补识别)的墙钟总预算(秒)，超出立即兜底。
# FILE_UNDERSTAND_VISION_DEADLINE_SEC=480
# Azure 备用：模型名(由 secrets/azure-models.yaml 解析端点/key)、PDF 拆页 DPI/每请求页数/最大页数。
# FILE_UNDERSTAND_AZURE_MODEL=FW-Kimi-K2.7-Code
# FILE_UNDERSTAND_AZURE_PAGE_DPI=150
# FILE_UNDERSTAND_AZURE_PAGES_PER_REQUEST=4
# FILE_UNDERSTAND_AZURE_MAX_PAGES=40
# 跨 worker 全局限流：并发上限、最大排队(秒,0=不限)、等待抖动比例、租约 TTL(秒)。
# FILE_UNDERSTAND_GLOBAL_CONCURRENCY=3
# FILE_UNDERSTAND_GLOBAL_MAX_WAIT_SEC=120
# FILE_UNDERSTAND_GLOBAL_WAIT_JITTER=0.3
# FILE_UNDERSTAND_GLOBAL_LEASE_TTL_SEC=600
# Redis 不可用策略：fallback_base=降级基础解析(推荐生产)；open=本地放开；fail=抛错。
# FILE_UNDERSTAND_LIMITER_UNAVAILABLE_POLICY=fallback_base
# 缺失/低质量图片逐图补识别（only_missing 策略）。
# FILE_UNDERSTAND_IMAGE_REPAIR_ENABLED=true
# FILE_UNDERSTAND_IMAGE_MIN_CAPTION_CHARS=8
# FILE_UNDERSTAND_IMAGE_REPAIR_CONCURRENCY=3
# FILE_UNDERSTAND_IMAGE_REPAIR_MAX_IMAGES=60
# LibreOffice(office->PDF 视觉输入)路径与转换超时。
# CONVERTER_SOFFICE_PATH=
# CONVERTER_DOC_CONVERT_TIMEOUT_SEC=180


