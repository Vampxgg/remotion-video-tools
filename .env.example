# JOB_SEARCH_SMTP_PORT=465
# JOB_SEARCH_SMTP_USERNAME=your@qq.com
# JOB_SEARCH_SMTP_PASSWORD=your-qq-mail-smtp-authorization-code
# JOB_SEARCH_SMTP_FROM=your@qq.com
# JOB_SEARCH_SMTP_USE_SSL=true
# JOB_SEARCH_SMTP_STARTTLS=false
# ZHAOPIN_DETAIL_API_TEMPLATE=https://fe-api.zhaopin.com/c/i/jobs/position-detail-new?number={number}
